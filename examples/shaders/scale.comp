#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) readonly buffer Source { float values[]; } source_data;
layout(set = 0, binding = 1) writeonly buffer Destination { float values[]; } destination_data;

void main() {
    uint index = gl_GlobalInvocationID.x;
    destination_data.values[index] = source_data.values[index] * 2.0 + 1.0;
}
