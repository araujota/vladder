{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vladder.dev/schemas/agent-review-v1.schema.json",
  "title": "vLadder Agent Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonical_prompt_version", "review_id", "created_at", "vladder_version",
    "reviewer", "project", "scope", "evidence", "assessment", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "vladder-agent-review-v1"},
    "canonical_prompt_version": {"const": "vladder-agent-review-prompt-v1"},
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "vladder_version": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "agent": {"type": "string", "minLength": 1, "maxLength": 120},
        "model": {"type": "string", "minLength": 1, "maxLength": 120},
        "provider": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "repository": {"type": ["string", "null"], "maxLength": 500},
        "revision": {"type": "string", "minLength": 7, "maxLength": 128}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "languages", "region_count", "workload"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 32}},
        "region_count": {"type": "integer", "minimum": 0},
        "workload": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["promotion_summary_sha256", "proof_class", "artifact_schema_versions", "benchmark_summary"],
      "properties": {
        "promotion_summary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "proof_class": {"type": "string", "minLength": 1, "maxLength": 200},
        "artifact_schema_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 120}},
        "benchmark_summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["rating", "outcome", "claim", "strengths", "limitations", "rejected_candidates", "unresolved_boundaries", "recommendations"],
      "properties": {
        "rating": {"type": "number", "minimum": 0, "maximum": 10},
        "outcome": {"enum": ["retained_win", "verified_negative", "partial_evidence", "workflow_failure", "revalidation"]},
        "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
        "strengths": {"$ref": "#/$defs/stringList"},
        "limitations": {"$ref": "#/$defs/stringList"},
        "rejected_candidates": {"$ref": "#/$defs/stringList"},
        "unresolved_boundaries": {"$ref": "#/$defs/stringList"},
        "recommendations": {"$ref": "#/$defs/stringList"}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_included", "raw_artifacts_included", "submission_consent"],
      "properties": {
        "source_included": {"const": false},
        "raw_artifacts_included": {"const": false},
        "submission_consent": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "stringList": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
