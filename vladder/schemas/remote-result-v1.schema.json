{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vladder.dev/schemas/remote-result-v1.schema.json",
  "title": "vLadder Remote Result v1",
  "type": "object",
  "required": ["schema_version", "hardware_manifest_sha256", "workload_manifest_sha256", "binary_sha256", "candidate_sha256", "metric"],
  "properties": {
    "schema_version": {"const": "vladder-remote-result-v1"},
    "hardware_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {"type": "number"},
    "unit": {"type": "string"},
    "observable_hash": {"type": "string"},
    "counters": {"type": "object"},
    "signature": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
